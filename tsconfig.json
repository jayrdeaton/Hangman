{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "paths": {
      "@/*": ["./*"],
      "@/components/*": ["./src/components/*"],
      "@/constants/*": ["./src/constants/*"],
      "@/hooks/*": ["./src/hooks/*"],
      "@/modes/*": ["./src/modes/*"],
      "@/redux/*": ["./src/redux/*"],
      "@/types/*": ["./src/types/*"],
      "@/utils/*": ["./src/utils/*"]
    },
    "types": ["react-native", "node", "jest"]
  },
  "include": [
    "**/*.ts",
    "**/*.tsx"
  ]
}
