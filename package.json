{
  "name": "ad-free-hangman",
  "version": "1.0.0",
  "main": "index.js",
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "expo lint .",
    "fix": "expo lint . --fix",
    "check": "tsc",
    "doctor": "expo install --fix && expo-doctor",
    "test": "jest",
    "test:watch": "jest --watchAll",
    "start": "expo start",
    "client": "expo start --dev-client",
    "reset": "expo start -c",
    "prebuild": "expo prebuild --clean",
    "prebuild:android": "expo prebuild --clean --platform android",
    "prebuild:ios": "expo prebuild --clean --platform ios",
    "build:web": "expo export -p web",
    "build:development": "eas build --profile development --local",
    "build:preview": "eas build --profile preview",
    "build:production": "eas build --profile production",
    "fingerprint:check": "eas fingerprint:compare",
    "run": "eas build:run",
    "update": "eas update",
    "update:bump": "rific-bump-ota src/constants/release.ts",
    "submit": "eas submit",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "ios:device": "expo run:ios --device"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@reduxjs/toolkit": "^2.12.0",
    "@rific/auto-paper": "^0.9.4",
    "@rific/drawer": "^0.4.1",
    "@rific/focus-chain": "^0.3.1",
    "@rific/haptic-press": "^0.6.1",
    "@rific/scroll-view": "^0.6.4",
    "@rific/splash-gate": "^0.1.2",
    "@rific/toaster": "^0.4.1",
    "@rific/updater": "^0.2.4",
    "expo": "~57.0.13",
    "expo-asset": "~57.0.6",
    "expo-audio": "~57.0.3",
    "expo-blur": "~57.0.2",
    "expo-dev-client": "~57.0.12",
    "expo-document-picker": "~57.0.1",
    "expo-file-system": "~57.0.1",
    "expo-font": "~57.0.1",
    "expo-haptics": "~57.0.1",
    "expo-linking": "~57.0.6",
    "expo-navigation-bar": "~57.0.2",
    "expo-sharing": "~57.0.12",
    "expo-splash-screen": "~57.0.6",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.1",
    "expo-updates": "~57.0.14",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-keyboard-controller": "1.21.9",
    "react-native-paper": "^5.15.3",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.10.1",
    "react-redux": "^9.3.0",
    "redux-persist": "^6.0.0"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.0",
    "@react-native/jest-preset": "^0.86.0",
    "@testing-library/react-native": "^14.0.0",
    "@types/jest": "29.5.14",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@typescript-eslint/eslint-plugin": "^8.64.0",
    "@typescript-eslint/parser": "^8.64.0",
    "babel-preset-expo": "^57.0.3",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-native": "^5.0.0",
    "eslint-plugin-simple-import-sort": "^13.0.0",
    "expo-doctor": "^1.20.1",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.4",
    "prettier": "^3.9.5",
    "react-refresh": "^0.18.0",
    "test-renderer": "^1.2.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.64.0"
  },
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "redux-persist",
          "@rific/updater"
        ]
      }
    }
  }
}
