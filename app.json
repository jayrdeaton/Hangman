{
  "expo": {
    "name": "Hangman",
    "slug": "Ad-Free-Hangman",
    "version": "1.0.0",
    "scheme": "hangman",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.infinitetoken.Hangman",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "UTExportedTypeDeclarations": [
          {
            "UTTypeIdentifier": "com.infinitetoken.hangman.pack",
            "UTTypeDescription": "Hangman Puzzle Pack",
            "UTTypeConformsTo": [
              "public.json"
            ],
            "UTTypeTagSpecification": {
              "public.filename-extension": [
                "hangman"
              ],
              "public.mime-type": "application/x-hangman"
            }
          }
        ],
        "CFBundleDocumentTypes": [
          {
            "CFBundleTypeName": "Hangman Puzzle Pack",
            "CFBundleTypeRole": "Editor",
            "LSHandlerRank": "Owner",
            "LSItemContentTypes": [
              "com.infinitetoken.hangman.pack"
            ]
          }
        ]
      },
      "icon": {
        "dark": "./assets/images/dark-icon.png",
        "light": "./assets/images/light-icon.png"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/splash-icon.png",
        "backgroundColor": "#F0F0F0"
      },
      "package": "com.infinitetoken.Hangman",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "data": [
            {
              "mimeType": "application/x-hangman"
            },
            {
              "scheme": "file",
              "host": "*",
              "pathPattern": ".*\\.hangman"
            },
            {
              "scheme": "content",
              "host": "*",
              "pathPattern": ".*\\.hangman"
            }
          ],
          "category": [
            "DEFAULT",
            "BROWSABLE"
          ]
        }
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/light-icon.png"
    },
    "plugins": [
      "expo-audio",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F0F0F0",
          "image": "./assets/images/splash-icon.png",
          "dark": {
            "image": "./assets/images/splash-icon.png",
            "backgroundColor": "#0F0F0F"
          },
          "imageWidth": 200
        }
      ],
      "expo-status-bar",
      "expo-font",
      "expo-asset",
      "expo-sharing"
    ],
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "extra": {
      "eas": {
        "projectId": "470e8522-592d-4311-b726-ea0bf8827144"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/470e8522-592d-4311-b726-ea0bf8827144"
    }
  }
}
