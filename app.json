{
  "expo": {
    "name": "Hangman",
    "slug": "Hangman",
    "version": "1.0.0",
    "scheme": "hangman",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/images/icon-dark.png",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.infinitetoken.Hangman",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "UTExportedTypeDeclarations": [
          {
            "UTTypeIdentifier": "com.infinitetoken.hangman.pack",
            "UTTypeDescription": "Hangman Puzzle Pack",
            "UTTypeConformsTo": [
              "public.json"
            ],
            "UTTypeTagSpecification": {
              "public.filename-extension": [
                "hangman"
              ],
              "public.mime-type": "application/x-hangman"
            }
          }
        ],
        "CFBundleDocumentTypes": [
          {
            "CFBundleTypeName": "Hangman Puzzle Pack",
            "CFBundleTypeRole": "Editor",
            "LSHandlerRank": "Owner",
            "LSItemContentTypes": [
              "com.infinitetoken.hangman.pack"
            ]
          }
        ]
      },
      "icon": {
        "dark": "./assets/images/icon-dark.png",
        "light": "./assets/images/icon-light.png"
      }
    },
    "android": {
      "package": "com.infinitetoken.Hangman",
      "intentFilters": [
        {
          "action": "VIEW",
          "data": [
            {
              "mimeType": "application/x-hangman"
            },
            {
              "scheme": "file",
              "host": "*",
              "pathPattern": ".*\\.hangman"
            },
            {
              "scheme": "content",
              "host": "*",
              "pathPattern": ".*\\.hangman"
            }
          ],
          "category": [
            "DEFAULT",
            "BROWSABLE"
          ]
        }
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/icon-dark.png"
    },
    "plugins": [
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-light.png",
          "imageWidth": 200,
          "backgroundColor": "#FAFAFA",
          "dark": {
            "image": "./assets/images/splash-dark.png",
            "backgroundColor": "#050505"
          }
        }
      ],
      "expo-font",
      "expo-asset",
      "expo-sharing",
      [
        "@tastic/core",
        {
          "drawsRotation": false
        }
      ]
    ],
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "extra": {
      "eas": {
        "projectId": "8bf1aca0-c256-4eb0-beb8-67900a6b315c"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/8bf1aca0-c256-4eb0-beb8-67900a6b315c"
    },
    "owner": "jayrdeaton"
  }
}
